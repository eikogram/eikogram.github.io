---
/**
 * Hero — the eikogram thesis.
 *
 * One format-neutral vector image model; transformers strictly between
 * models; SVG is one serialization among several, not the hub. A plotted
 * bezier draws itself in behind the headline (disabled under
 * prefers-reduced-motion).
 */
---

<section class="hero">
  <div class="hero-grid dotgrid" aria-hidden="true"></div>
  <svg class="hero-plot" viewBox="0 0 560 300" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <path
      class="plot-curve"
      d="M 30 250 C 120 90, 220 280, 330 160 C 410 72, 470 120, 540 70"
    ></path>
    <rect class="plot-anchor" x="26" y="246" width="9" height="9" transform="rotate(45 30 250)"></rect>
    <rect class="plot-anchor" x="325" y="155" width="9" height="9" transform="rotate(45 330 160)"></rect>
    <rect class="plot-anchor plot-anchor-alt" x="535" y="65" width="9" height="9" transform="rotate(45 540 70)"></rect>
    <line class="plot-handle" x1="30" y1="250" x2="120" y2="90"></line>
    <line class="plot-handle" x1="330" y1="160" x2="470" y2="120"></line>
  </svg>

  <div class="hero-inner">
    <p class="eyebrow">eikogram · the internal vector image model</p>
    <h1 class="hero-title">
      One model. Every drawing is a<br class="hero-br" />
      <em>transformer</em> away.
    </h1>
    <p class="hero-lede">
      eikogram is the format-neutral super-model for vector drawings:
      <strong>one model per format</strong>, and <strong>transformers strictly
      between models</strong> &mdash; never bytes to bytes.
    </p>
    <p class="hero-hub">
      SVG is one serialization among several, not the center of the world.
      The drawing lives in the model; the format is a projection of it.
    </p>

    <div class="hero-formats" role="list" aria-label="Supported formats">
      <span class="fmt-chip fmt-emf" role="listitem">EMF</span>
      <span class="fmt-link" aria-hidden="true">&#8596;</span>
      <span class="fmt-chip fmt-svg" role="listitem">SVG</span>
      <span class="fmt-link" aria-hidden="true">&#8596;</span>
      <span class="fmt-chip fmt-png" role="listitem">PNG / DIB</span>
    </div>

    <div class="hero-actions">
      <a class="cta-primary" href="#model-flow">See the model flow</a>
      <a class="cta-secondary" href="https://github.com/claricle" target="_blank" rel="noopener">
        The gem suite on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6.5rem 1.5rem 5rem;
    text-align: center;
    isolation: isolate;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 30%, transparent 75%);
  }
  .hero-plot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.5;
  }
  .plot-curve {
    fill: none;
    stroke: var(--color-ink-brand);
    stroke-width: 1.6;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: plot-draw 1.8s ease-out 0.2s forwards;
  }
  .plot-anchor {
    fill: var(--color-ink-brand);
    opacity: 0;
    animation: plot-anchor-in 0.4s ease 1.6s forwards;
  }
  .plot-anchor-alt {
    fill: var(--color-fmt-png);
  }
  .plot-handle {
    stroke: var(--color-ink-muted);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0;
    animation: plot-anchor-in 0.5s ease 1.8s forwards;
  }
  @keyframes plot-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes plot-anchor-in {
    to { opacity: 0.55; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plot-curve { animation: none; stroke-dashoffset: 0; }
    .plot-anchor, .plot-handle { animation: none; opacity: 0.55; }
  }

  .hero-inner {
    max-width: 780px;
    margin: 0 auto;
  }
  .hero-title {
    margin: 0.9rem 0 1.2rem;
    font-size: clamp(2.3rem, 6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 750;
  }
  .hero-title em {
    font-style: normal;
    color: var(--color-ink-brand);
  }
  .hero-lede {
    margin: 0 auto 0.8rem;
    max-width: 620px;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .hero-hub {
    margin: 0 auto;
    max-width: 600px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }
  .hero-formats {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 1.8rem 0 0.4rem;
  }
  .fmt-chip {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.8rem;
    border-radius: 8px;
    border: 1.5px solid currentColor;
    background: var(--color-canvas);
  }
  .fmt-emf { color: var(--color-fmt-emf); }
  .fmt-svg { color: var(--color-fmt-svg); }
  .fmt-png { color: var(--color-fmt-png); }
  .fmt-link {
    color: var(--color-ink-muted);
    font-size: 1rem;
  }
  .hero-actions {
    display: inline-flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.8rem;
  }
  .cta-primary, .cta-secondary {
    display: inline-block;
    padding: 0.65rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .cta-primary {
    background: var(--color-ink-brand);
    color: #ffffff;
  }
  .cta-primary:hover { transform: translateY(-1px); }
  .cta-secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
  .cta-secondary:hover { background: var(--color-canvas-soft); }
  .hero-br { display: none; }
  @media (min-width: 720px) {
    .hero-br { display: inline; }
  }
</style>
