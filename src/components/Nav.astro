---
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/#model-flow', label: 'Model flow' },
  { href: '/#quickstart', label: 'Quickstart' },
];
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label="eikogram home">
      <Logo size={30} />
      <span class="brand-name">eikogram</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href) }]}
          aria-current={isActive(link.href) && link.href !== '/#model-flow' && link.href !== '/#quickstart' ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/eikogram"
        class="nav-icon"
        aria-label="eikogram on GitHub"
        rel="noopener"
        target="_blank"
      >
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a
        href="https://github.com/claricle"
        class="nav-icon"
        aria-label="the claricle suite on GitHub"
        rel="noopener"
        target="_blank"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          <path d="M17.5 14v7M14 17.5h7"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-canvas) 88%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 650;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft);
  }
  .nav-link.active {
    color: var(--color-ink);
    font-weight: 550;
  }
  .nav-icon {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.55rem;
    border-radius: 8px;
    color: var(--color-ink-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-icon:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft);
  }
  @media (max-width: 640px) {
    .nav-link {
      padding: 0.4rem 0.45rem;
      font-size: 0.85rem;
    }
    .brand-name {
      font-size: 1rem;
    }
  }
</style>
